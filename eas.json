{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "staging": {
      "channel": "staging",
      "android": {
        "withoutCredentials": true,
        "buildType": "apk",
        "distribution": "internal"
      }
    },
    "production": {
      "channel": "production",
      "credentialsSource": "remote",
      "android": {
        "gradleCommand": ":app:assembleRelease"
      }
    }
  }
}
